# Copy to `.env` (git-ignored) and fill in the real bench addresses, or export
# these variables in your CI / test runner. The values below are PLACEHOLDERS.
#
# Bench instrument hosts (IP or hostname). Required to talk to real hardware.
LAB_EQUIPMENT_PSU_HOST=192.0.2.2
LAB_EQUIPMENT_AWG_HOST=192.0.2.3
LAB_EQUIPMENT_DMM_HOST=192.0.2.4

# Optional VISA settings (defaults shown).
LAB_EQUIPMENT_VISA_BACKEND=@py
LAB_EQUIPMENT_SOCKET=0
LAB_EQUIPMENT_TIMEOUT_MS=5000
